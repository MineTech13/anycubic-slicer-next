# shellcheck shell=bash
# Single source of truth for the application ID, sourced by the build and test scripts.
APP_ID=io.github.minetech13.AnycubicSlicer
# Former Flatpak ID. Its ref is kept in the Flatpak repo with an end-of-life rebase to
# APP_ID, so existing installs move to the new ID (with their data) on `flatpak update`.
LEGACY_APP_ID=com.anycubic.AnycubicSlicer
